{
  "name": "@repo/usages-data",
  "private": true,
  "license": "MIT",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite build && pnpm exec concurrently -k -n build,preview \"vite build --watch\" \"vite preview --port 5177 --strictPort\"",
    "dev:standalone": "vite --port 5177 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5177 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@repo/api-client": "workspace:^",
    "@repo/types": "workspace:^",
    "@repo/ui": "workspace:^",
    "@tabler/icons-react": "^3.46.0",
    "@tanstack/react-query": "^5.83.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@originjs/vite-plugin-federation": "^1.3.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.26",
    "tailwindcss": "4",
    "typescript": "~5.9.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  }
}
