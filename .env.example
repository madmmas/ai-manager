# Database
DB_PASSWORD=changeme
# Host port for Compose Postgres (container still listens on 5432)
POSTGRES_PORT=5433

# Security (change these before any shared/demo deployment)
# Min 32 chars — used to sign JWT access/refresh tokens (httpOnly cookies)
JWT_SECRET=change-me-min-32-chars-for-local-dev-only!!
SECRET_KEY=change-me-for-encrypting-provider-keys

# Config Server mode: native | jdbc | git
# native = classpath:/config (default local scaffold)
# jdbc = shared Postgres config_properties (Flyway V9; requires api-server migrations)
# git = remote repo (CONFIG_GIT_URI); not exercised in CI
CONFIG_MODE=native

# Git mode only
CONFIG_GIT_URI=https://github.com/your-org/aiplane-config

# LLM Providers (optional — can also be configured per-project in the UI later)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
